<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>cz.osu</groupId>
    <artifactId>SportMeet</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>SportMeet parent</name>
    <description>SportMeet</description>
    <properties>
        <java.version>25</java.version>
        <!-- overrides of Spring Boot managed versions because of known vulnerabilities -->
        <tomcat.version>11.0.29</tomcat.version>
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <hibernate-validator.version>9.1.6.Final</hibernate-validator.version>
        <postgresql.version>42.7.14</postgresql.version>
        <h2.version>2.5.252</h2.version>
        <json-smart.version>2.6.1</json-smart.version>
        <asm.version>9.11.1</asm.version>
        <archunit.version>1.5.1</archunit.version>
        <jacoco.version>0.8.14</jacoco.version>
    </properties>
    <packaging>pom</packaging>
    <modules>

        <module>sportmeet-common</module>
        <module>sportmeet-user</module>
        <module>sportmeet-app</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
